{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Life OS",
  "version": "0.3.0",
  "identifier": "com.lifeos.app",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Life OS",
        "width": 1000,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
