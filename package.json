{
  "name": "life-os",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build",
    "build:android:m0:web": "tsc && vite build --mode android-m0",
    "dev:android:m0:web": "vite --mode android-m0",
    "build:android:m1:web": "tsc && vite build --mode android-m1",
    "dev:android:m1:web": "vite --mode android-m1",
    "build:android:m2a:web": "tsc && vite build --mode android-m2a",
    "dev:android:m2a:web": "vite --mode android-m2a",
    "android:m0:init": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/android-m0.ps1 -Action Init",
    "android:m0:build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/android-m0.ps1 -Action Build",
    "android:m0:inspect": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/android-m0.ps1 -Action Inspect",
    "android:m1:build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/android-m1.ps1 -Action Build",
    "android:m1:inspect": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/android-m1.ps1 -Action Inspect",
    "android:m1:native": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/android-m1-native-review.ps1",
    "android:m2a:build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/android-m2a.ps1 -Action Build",
    "android:m2a:inspect": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/android-m2a.ps1 -Action Inspect",
    "android:m2a:native": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/android-m2a-native-review.ps1",
    "preview": "vite preview",
    "start:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-life-os.ps1",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:workflow": "node --test scripts/ai-workflow.node-test.mjs",
    "verify:workflow": "node scripts/ai-workflow.mjs validate",
    "workflow:validate": "node scripts/ai-workflow.mjs validate",
    "workflow:status": "node scripts/ai-workflow.mjs status",
    "workflow:start": "node scripts/ai-workflow.mjs start",
    "workflow:start-terminal-follow-up": "node scripts/ai-workflow.mjs start-terminal-follow-up",
    "workflow:record-artifact": "node scripts/ai-workflow.mjs record-artifact",
    "workflow:transition": "node scripts/ai-workflow.mjs transition",
    "workflow:resolve-decision": "node scripts/ai-workflow.mjs resolve-decision",
    "workflow:record-verification": "node scripts/ai-workflow.mjs record-verification",
    "workflow:archive": "node scripts/ai-workflow.mjs archive"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-sql": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^3.2.7"
  }
}
