{
  "name": "life-os",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-life-os.ps1",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:workflow": "node --test scripts/ai-workflow.node-test.mjs",
    "verify:workflow": "node scripts/ai-workflow.mjs validate",
    "workflow:validate": "node scripts/ai-workflow.mjs validate",
    "workflow:status": "node scripts/ai-workflow.mjs status",
    "workflow:start": "node scripts/ai-workflow.mjs start",
    "workflow:record-artifact": "node scripts/ai-workflow.mjs record-artifact",
    "workflow:transition": "node scripts/ai-workflow.mjs transition",
    "workflow:resolve-decision": "node scripts/ai-workflow.mjs resolve-decision",
    "workflow:record-verification": "node scripts/ai-workflow.mjs record-verification",
    "workflow:archive": "node scripts/ai-workflow.mjs archive"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-sql": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^3.2.7"
  }
}
